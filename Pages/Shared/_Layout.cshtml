@{
    var req = ViewContext.HttpContext.Request;
    var back = Uri.EscapeDataString(req.Path.Value + req.QueryString.Value);
}
<!DOCTYPE html>
<html lang="@L.Lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#d97706" />
    <title>@ViewData["Title"] – @L["site.name"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="top"><div class="top-in">
        <a class="brand" asp-page="/Index">🏆 @L["site.name"]</a>
        <nav class="menu">
            <a asp-page="/Index">@L["nav.week"]</a>
            <a asp-page="/Guide">@L["nav.guide"]</a>
        </nav>
        <div class="tools">
            <span class="lang">
                <a href="/lang/bg?returnUrl=@back" class="@(L.Lang == "bg" ? "on" : "")">BG</a><a href="/lang/en?returnUrl=@back" class="@(L.Lang == "en" ? "on" : "")">EN</a>
            </span>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="muted">@User.Identity.Name</span>
                <form method="post" asp-page="/Account/Logout" class="inline">
                    <button type="submit" class="linkbtn">@L["nav.logout"]</button>
                </form>
            }
            else
            {
                <a class="btn" asp-page="/Account/Login">@L["nav.login"]</a>
                <a class="btn primary" asp-page="/Account/Register">@L["nav.register"]</a>
            }
        </div>
    </div></header>
    <main class="wrap">@RenderBody()</main>
    <footer class="foot">@L["footer"]</footer>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</body>
</html>
