@page
@model IndexModel
@{
    var title = L.Pick(Model.Topic.Title, Model.Topic.TitleEn);
    ViewData["Title"] = title;
    var loggedIn = Model.UserId != null;
    var req = ViewContext.HttpContext.Request;
    var back = req.Path.Value + req.QueryString.Value;
    var rank = 0;
    var maxVotes = Model.Rows.Count == 0 ? 0 : Model.Rows.Max(r => r.Votes);
    var endIso = Model.Topic.EndsOn.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'");
}

@if (TempData["Msg"] is string msg) { <p class="msg">@msg</p> }

<section class="hero @(Model.CoverUrl == null ? "nocover" : "")" style="@(Model.CoverUrl != null ? $"--cover:url('{Model.CoverUrl}')" : "")">
    <div class="hero-in">
        <span class="badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 16.8l-5.5 2.9 1-6.1-4.4-4.3 6.1-.9z"/></svg>@L["hero.badge"]</span>
        <h1><span class="lead-in">@L["hero.lead"]</span> <span class="topic">@title</span></h1>
        <p class="sub">@L["hero.sub"]</p>
        <div class="cta">
            <a class="btn primary big" href="#rows">@L["hero.vote"] <span aria-hidden="true">→</span></a>
            <button type="button" class="btn glass" data-share data-title="@title" data-copied="@L["share.copied"]">@L["share.btn"]</button>
        </div>
    </div>
</section>

<div class="stats">
    <div class="stat">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
        <div><small>@L["home.endsIn"]</small><b data-countdown="@endIso" data-d="@L["unit.d"]" data-h="@L["unit.h"]" data-m="@L["unit.m"]"></b></div>
    </div>
    <div class="stat">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 11v10H4V11zM7 11l4-8a2.5 2.5 0 0 1 2.5 2.5V9h5.2a2 2 0 0 1 2 2.3l-1.3 8A2 2 0 0 1 17.4 21H7"/></svg>
        <div><b>@Model.Total</b> <span>@L["stat.votes"]</span></div>
    </div>
    <div class="stat">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0zM7 6H4v1a3 3 0 0 0 3 3M17 6h3v1a3 3 0 0 1-3 3"/></svg>
        <div><b>@Model.Rows.Count</b> <span>@L["stat.places"]</span></div>
    </div>
    <a class="stat link" href="#nominate">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M17 8v6M14 11h6"/></svg>
        <div><small>@L["stat.nominate"]</small><b>@L["stat.nominateLink"]</b></div>
    </a>
</div>

<p class="muted closes">@L.Format("home.closes", Model.Topic.EndsOn.AddDays(-1).ToString("d MMMM yyyy", L.Culture))</p>

@if (Model.LastWinner is { Top.Count: > 0 } lw)
{
    <p class="winner">@L["home.lastWinner"] (@L.Pick(lw.Title, lw.TitleEn)): <b>@lw.Top[0].Name</b></p>
}

@if (Model.Neighborhoods.Count > 0)
{
    <div class="pills">
        <a asp-page="/Index" class="@(string.IsNullOrEmpty(Model.Hood) ? "on" : "")">@L["home.all"]</a>
        @foreach (var h in Model.Neighborhoods)
        {
            <a asp-page="/Index" asp-route-hood="@h" class="@(Model.Hood == h ? "on" : "")">@h</a>
        }
    </div>
}

@if (Model.Rows.Count == 0)
{
    <div class="empty" id="rows">
        <p class="empty-big">@L["home.empty"]</p>
        <a class="btn primary" href="#nominate">@L["nom.h"]</a>
    </div>
}
else
{
    @if (Model.Rows.Count > 5)
    {
        <input type="search" class="search" data-filter="#rows" placeholder="@L["search.ph"]" />
    }
    <ol class="rows" id="rows">
    @foreach (var r in Model.Rows)
    {
        rank++;
        var pct = maxVotes == 0 ? 0 : r.Votes * 100 / maxVotes;
        var isLead = rank == 1 && r.Votes > 0;
        var photo = Photos.Url(r.PlaceId);
        var canAddPhoto = photo == null && loggedIn && r.NominatorKey == Model.UserId;
        <li class="row @(isLead ? "lead" : "") @(Model.MyVote == r.NominationId ? "mine" : "")">
            @if (photo != null)
            {
                <img class="photo" src="@photo" alt="@r.Name" loading="lazy" />
            }
            else
            {
                <span class="photo none" aria-hidden="true">@r.Name.Substring(0, 1)</span>
            }
            <div class="rank">@(isLead ? "№1" : rank.ToString())</div>
            <div class="body">
                <div class="name" style="--share:@pct%"><strong>@r.Name</strong></div>
                @if (!string.IsNullOrEmpty(r.Neighborhood)) { <div class="hood">@r.Neighborhood</div> }
                @if (canAddPhoto)
                {
                    <form method="post" enctype="multipart/form-data" asp-page-handler="Photo" asp-route-hood="@Model.Hood" class="addphoto">
                        <input type="hidden" name="nominationId" value="@r.NominationId" />
                        <label>@L["photo.add"]<input type="file" name="Photo" accept="image/jpeg,image/png,image/webp" data-autosubmit /></label>
                    </form>
                }
            </div>
            <form method="post" class="vote" asp-page-handler="Vote" asp-route-hood="@Model.Hood">
                <input type="hidden" name="nominationId" value="@r.NominationId" />
                <span class="count">@r.Votes <span class="unit">@L["votes"]</span></span>
                @if (!loggedIn)
                {
                    <a class="btn" asp-page="/Account/Login" asp-route-returnUrl="@back">@L["btn.loginToVote"]</a>
                }
                else if (Model.MyVote == r.NominationId)
                {
                    <span class="voted-label">@L["btn.voted"]</span>
                    <button type="submit" class="ghost" asp-page-handler="Unvote" asp-route-hood="@Model.Hood"
                            data-confirm="@L["btn.unvote.confirm"]">@L["btn.unvote"]</button>
                }
                else if (Model.MyVote == null)
                {
                    <button type="submit" class="primary">@L["btn.vote"]</button>
                }
            </form>
        </li>
    }
    </ol>
}

<h2 id="nominate">@L["nom.h"]</h2>
@if (!loggedIn)
{
    <p class="card"><a asp-page="/Account/Login" asp-route-returnUrl="@back">@L["nom.login"]</a></p>
}
else
{
    <form method="post" class="nominate" enctype="multipart/form-data" asp-page-handler="Nominate" asp-route-hood="@Model.Hood">
        <select asp-for="Choice" class="grow" data-place-select data-other-target="#other-fields">
            <option value="">@L["nom.choose"]</option>
            @foreach (var g in BestInTown.Data.PlaceCatalog.All
                .Where(p => !Model.Nominated.Contains(p.Name.ToUpperInvariant()))
                .GroupBy(p => p.Category))
            {
                <optgroup label="@L["cat." + g.Key]">
                    @foreach (var p in g)
                    {
                        <option value="@p.Name">@p.Name@(p.Neighborhood != null ? " · " + p.Neighborhood : "")</option>
                    }
                </optgroup>
            }
            <option value="@IndexModel.OtherChoice">@L["nom.other"]</option>
        </select>
        <div id="other-fields" class="other">
            <input type="text" asp-for="Name" placeholder="@L["nom.name"]" maxlength="80" />
            @if (Model.AllowedNeighborhoods.Length > 0)
            {
                <select asp-for="Neighborhood">
                    <option value="">@L["nom.hoodSelect"]</option>
                    @foreach (var h in Model.AllowedNeighborhoods) { <option value="@h">@h</option> }
                </select>
            }
            else
            {
                <input type="text" asp-for="Neighborhood" placeholder="@L["nom.hood"]" maxlength="60" />
            }
        </div>
        <label class="file">
            <span>@L["photo.optional"]</span>
            <input type="file" asp-for="Photo" accept="image/jpeg,image/png,image/webp" />
        </label>
        <button type="submit" class="primary">@L["nom.btn"]</button>
    </form>
}
