@page
@model GuideModel
@{
    ViewData["Title"] = L["guide.h"];
}

<h1>@L["guide.h"]</h1>
<p class="muted">@L["guide.sub"]</p>

@if (Model.Entries.Count == 0)
{
    <p class="card">@L["guide.empty"]</p>
}
@foreach (var e in Model.Entries)
{
    var i = 0;
    <section class="week">
        <h2>@L.Pick(e.Title, e.TitleEn)</h2>
        <p class="when">@e.EndsOn.AddDays(-7).ToString("d MMM", L.Culture) – @e.EndsOn.AddDays(-1).ToString("d MMM yyyy", L.Culture)</p>
        <ol class="podium">
            @foreach (var r in e.Top)
            {
                <li>
                    <span class="rank">@(++i)</span>
                    <strong>@r.Name</strong>
                    @if (!string.IsNullOrEmpty(r.Neighborhood)) { <span class="hood">@r.Neighborhood</span> }
                    <span class="count">@r.Votes @L["votes"]</span>
                </li>
            }
        </ol>
    </section>
}
