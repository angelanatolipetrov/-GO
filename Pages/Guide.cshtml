@page
@model GuideModel
@{
    ViewData["Title"] = L["guide.h"];
    var medals = new[] { "🥇", "🥈", "🥉" };
}

<h1>@L["guide.h"]</h1>
<p class="muted">@L["guide.sub"]</p>

@if (Model.Entries.Count == 0)
{
    <p class="card">@L["guide.empty"]</p>
}
@foreach (var e in Model.Entries)
{
    var i = 0;
    <section class="card" style="margin-bottom:1rem">
        <h2>@L.Pick(e.Title, e.TitleEn) <span class="chip small">@e.EndsOn.AddDays(-1).ToString("MMM yyyy", L.Culture)</span></h2>
        <ol class="podium">
            @foreach (var r in e.Top)
            {
                <li>
                    <span class="rank">@medals[i++]</span>
                    <strong>@r.Name</strong>
                    @if (!string.IsNullOrEmpty(r.Neighborhood)) { <span class="chip small">@r.Neighborhood</span> }
                    <span class="count">@r.Votes @L["votes"]</span>
                </li>
            }
        </ol>
    </section>
}
