@page
@model BestInTown.Pages.Account.VerifyModel
@{ ViewData["Title"] = L["verify.h"]; }

<h1>@L["verify.h"]</h1>

@if (TempData["Msg"] is string msg) { <p class="msg">@msg</p> }
@if (TempData.Peek("DevCode") is string devCode)
{
    <p class="msg">@L["verify.dev"] <strong class="devcode">@devCode</strong></p>
}
@if (Model.Error != null) { <div class="errors"><p>@Model.Error</p></div> }

<p>@L.Format("verify.sub", Model.Email ?? "")</p>

<form method="post" class="stack" asp-route-email="@Model.Email" asp-route-returnUrl="@Model.ReturnUrl">
    <label asp-for="Code">@L["verify.code"]</label>
    <input asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}"
           maxlength="7" class="code" required autofocus />
    <button type="submit" class="primary">@L["verify.btn"]</button>
</form>

<form method="post" asp-page-handler="Resend" asp-route-email="@Model.Email" asp-route-returnUrl="@Model.ReturnUrl">
    <p class="muted">@L["verify.noMail"] <button type="submit" class="linkbtn">@L["verify.resend"]</button></p>
</form>
