@page
@model BestInTown.Pages.Admin.IndexModel
@{ ViewData["Title"] = L["admin.h"]; }

<h1>@L["admin.h"]</h1>

<h2>@L["admin.topic"]</h2>
<form method="post" asp-page-handler="Rename">
    <input type="hidden" name="id" value="@Model.Topic.Id" />
    <input type="text" name="title" value="@Model.Topic.Title" placeholder="@L["admin.titleBg"]" maxlength="120" size="36" />
    <input type="text" name="titleEn" value="@Model.Topic.TitleEn" placeholder="@L["admin.titleEn"]" maxlength="120" size="36" />
    <button type="submit">@L["admin.save"]</button>
</form>

<h2>@L["admin.cover"]</h2>
@if (TempData["Msg"] is string err) { <div class="errors"><p>@L[err]</p></div> }
<p class="muted">@L["admin.coverHint"]</p>
@if (Photos.TopicUrl(Model.Topic.Id) is string cover)
{
    <p><img src="@cover" alt="" class="cover-preview" /></p>
    <form method="post" asp-page-handler="DeleteCover" class="inline">
        <input type="hidden" name="id" value="@Model.Topic.Id" />
        <button type="submit">@L["admin.deleteCover"]</button>
    </form>
}
<form method="post" enctype="multipart/form-data" asp-page-handler="Cover" class="inline">
    <input type="hidden" name="id" value="@Model.Topic.Id" />
    <input type="file" name="cover" accept="image/jpeg,image/png,image/webp" required />
    <button type="submit" class="primary">@L["admin.uploadCover"]</button>
</form>

<h2>@L["admin.card"]</h2>
<p class="muted">@L["admin.cardHint"]</p>
@if (Photos.CardUrl(Model.Topic.Id) is string card)
{
    <p><img src="@card" alt="" class="cover-preview" /></p>
    <form method="post" asp-page-handler="DeleteCard" class="inline">
        <input type="hidden" name="id" value="@Model.Topic.Id" />
        <button type="submit">@L["admin.deleteCover"]</button>
    </form>
}
<form method="post" enctype="multipart/form-data" asp-page-handler="Card" class="inline">
    <input type="hidden" name="id" value="@Model.Topic.Id" />
    <input type="file" name="cover" accept="image/jpeg,image/png,image/webp" required />
    <button type="submit" class="primary">@L["admin.uploadCover"]</button>
</form>

<h2>@L["admin.noms"]</h2>
@if (Model.Rows.Count == 0) { <p class="muted">@L["admin.none"]</p> }
<ol class="rows">
@foreach (var r in Model.Rows)
{
    <li>
        <div class="row-top">
            <div><strong>@r.Name</strong> <span class="muted">@r.Neighborhood · @r.Votes @L["votes"]</span></div>
            <div class="inline">
                @if (Photos.Url(r.PlaceId) is string url)
                {
                    <a href="@url" target="_blank"><img src="@url" alt="" class="thumb" /></a>
                    <form method="post" class="inline" asp-page-handler="DeletePhoto">
                        <input type="hidden" name="placeId" value="@r.PlaceId" />
                        <button type="submit">@L["admin.deletePhoto"]</button>
                    </form>
                }
                <form method="post" class="inline" asp-page-handler="Delete">
                    <input type="hidden" name="id" value="@r.NominationId" />
                    <button type="submit">@L["admin.delete"]</button>
                </form>
            </div>
        </div>
    </li>
}
</ol>
